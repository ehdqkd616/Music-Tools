# ── Database ─────────────────────────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=app_pass
POSTGRES_DB=studio
DATABASE_URL=postgresql+psycopg://app:app_pass@postgres:5432/studio

# ── Redis (queue + cache + progress pub/sub) ────────────────
REDIS_URL=redis://redis:6379/0

# ── Object storage (MinIO locally, S3 in prod) ──────────────
S3_ENDPOINT=http://minio:9000
# Endpoint the browser can reach for presigned URLs — must be the whole domain with
# no path prefix (presigned SigV4 signs the Host header, so a stripped-prefix reverse
# proxy would break signature verification).
S3_PUBLIC_ENDPOINT=https://media.hotgarlic.dedyn.io
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=studio-media
S3_REGION=us-east-1

# ── Admin bootstrap ────────────────────────────────────────
# 관리자 아이디는 모든 프로젝트 공통으로 "admin" 이다. api가 시작할 때마다
# admin 계정을 만들거나, 이미 있으면 비밀번호를 이 값으로 맞춘다.
ADMIN_PASSWORD=

# ── 회원가입 알림 메일 ─────────────────────────────────────
# 가입이 들어오면 아래 주소로 승인 요청 메일을 보낸다 (쉼표로 여러 명 가능).
# Gmail로 보낼 땐 보내는 계정에서 2단계 인증을 켜고 "앱 비밀번호"를 만들어
# SMTP_PASSWORD에 넣는다 (일반 비밀번호로는 로그인이 거부된다).
ADMIN_NOTIFY_EMAILS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 메일 속 "관리자 페이지에서 승인하기" 버튼이 가리킬 사이트 주소
PUBLIC_WEB_URL=http://localhost:3000

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Limits (§2.1 / §14.1) ────────────────────────────────
# NOTE: §14.1's production numbers (10 downloads / 2 separations per day) are
# an anti-abuse limit for public traffic. Locally, every request from this
# machine shares one IP-hash quota bucket, so the design-doc numbers make
# solo dev testing hit the wall almost immediately — these defaults are
# relaxed for local use. Tighten them back up before any public deploy.
MAX_UPLOAD_MB=1024
MAX_UPLOAD_DURATION_SEC=3600
MAX_YOUTUBE_DURATION_SEC=3600
ANON_DAILY_DOWNLOAD_LIMIT=100
ANON_DAILY_SEPARATE_LIMIT=50

# §5.3/§15.2's 24h TTL exists to bound storage/legal exposure for a public
# service. This is a personal, non-public instance, so results are kept for
# a year by default instead — the beat task that purges expired media still
# runs, it just won't touch anything for a long time. Lower this back to 24
# before ever exposing this to other users.
MEDIA_TTL_HOURS=8760

# ── yt-dlp (§5.1.3) ──────────────────────────────────────
# Optional residential proxy, e.g. http://user:pass@host:port. Leave empty locally.
PROXY_URL=
COOKIE_PATH=

# ── Demucs (§5.2.1) ──────────────────────────────────────
# This stack runs Demucs on CUDA (NVIDIA GPU host) — see README.
DEMUCS_DEVICE=cuda
DEMUCS_FAST_MODEL=htdemucs
DEMUCS_HQ_MODEL=htdemucs_ft

# ── Frontend ─────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000
