# ── Database ─────────────────────────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=app_pass
POSTGRES_DB=studio
DATABASE_URL=postgresql+psycopg://app:app_pass@postgres:5432/studio

# ── Redis (queue + cache + progress pub/sub) ────────────────
REDIS_URL=redis://redis:6379/0

# ── Object storage (MinIO locally, S3 in prod) ──────────────
S3_ENDPOINT=http://minio:9000
# Endpoint the browser can reach for presigned URLs (MinIO is on the host too)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=studio-media
S3_REGION=us-east-1

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Limits (§2.1 / §14.1) ────────────────────────────────
MAX_UPLOAD_MB=100
MAX_UPLOAD_DURATION_SEC=900
MAX_YOUTUBE_DURATION_SEC=1200
ANON_DAILY_DOWNLOAD_LIMIT=10
ANON_DAILY_SEPARATE_LIMIT=2

# ── yt-dlp (§5.1.3) ──────────────────────────────────────
# Optional residential proxy, e.g. http://user:pass@host:port. Leave empty locally.
PROXY_URL=
COOKIE_PATH=

# ── Demucs (§5.2.1) ──────────────────────────────────────
# This stack runs Demucs on CPU (no CUDA locally) — see README.
DEMUCS_DEVICE=cpu
DEMUCS_FAST_MODEL=htdemucs
DEMUCS_HQ_MODEL=htdemucs_ft

# ── Frontend ─────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000
